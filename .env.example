# Secure RDMS configuration template.
# The application reads these values with getenv(), so export them in your shell
# or configure them in Apache (SetEnv). This file is a reference, not auto-loaded.

RDMS_DB_HOST=127.0.0.1
RDMS_DB_PORT=3306
RDMS_DB_NAME=secure_rdms
RDMS_DB_USER=root
RDMS_DB_PASS=

# Replace with a long random value before storing any real research data.
RDMS_ENCRYPTION_KEY=local-demo-key-change-before-deployment
